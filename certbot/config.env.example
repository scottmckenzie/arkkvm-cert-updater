# arkkvm-cert-updater settings.
# Copy to ~/.config/arkkvm-cert-updater/config.env and keep it private:
#   install -d -m 700 ~/.config/arkkvm-cert-updater
#   install -m 600 config.env.example ~/.config/arkkvm-cert-updater/config.env
# Command-line options and real environment variables override these values.
# Use absolute paths: "~" and $HOME are not expanded in this file.
# Root is not supported: run everything as a normal user.

# ArkKVM web address. Must be https://host[:port], with no path.
ARKKVM_URL=https://arkkvm.example.com

# Local password of the ArkKVM web UI. Keep it in Proton Pass as a pass:// reference (see below),
# or put the password itself here and keep this file mode 600. There is no command-line option.
ARKKVM_PASSWORD="pass://<vault>/<item>/password"

# certbot certificate name (the directory under <certbot config-dir>/live). Required. The deploy
# hook and the updater both skip any other certificate.
ARKKVM_CERT_NAME=arkkvm.example.com

# SHA-256 fingerprint of the ArkKVM's current certificate, to trust it for the FIRST install only.
# Enable the self-signed certificate in the KVM's web UI, read its fingerprint in your browser,
# and remove this line after the first install.
#ARKKVM_TLS_FINGERPRINT=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99

# CA file used to verify the ArkKVM instead of the system CAs (default: the system CAs).
#ARKKVM_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Seconds to wait for the ArkKVM to come back with the new certificate after its reboot (default 300).
#ARKKVM_RESET_TIMEOUT=300

# Seconds to wait for each network operation (default 20).
#ARKKVM_TIMEOUT=20

# --- Proton Pass (optional) ---------------------------------------------------
# Keep secrets in Proton Pass instead of this file. When a Proton Pass token is set
# (below, or in ARKKVM_PASS_TOKEN_FILE), the deploy hook logs in with it and runs the
# updater under `pass-cli run`, so any value above can be a pass:// reference.
# Create an agent that can read only that vault, and paste the line it prints here:
#   pass-cli agent create arkkvm-cert-updater --expiration 1y --vault <vault>
# A plain `pass-cli personal-access-token create` token works too. The hook uses a
# private throwaway pass-cli session, so your own pass-cli login is not affected, and
# only `pass-cli login` ever sees the token.
#PROTON_PASS_PERSONAL_ACCESS_TOKEN=pst_xxxx...xxxx::TOKENKEY
# Reason recorded in the agent's audit log (`pass-cli agent monitor`), at most 300
# characters. Default: one naming the certificate.
#PROTON_PASS_AGENT_REASON="Install the renewed TLS certificate on the ArkKVM"
# Or keep the token in its own file (mode 600) instead of this one:
#ARKKVM_PASS_TOKEN_FILE=/home/you/.config/arkkvm-cert-updater/pass-token
#ARKKVM_PASS_CLI=/home/you/.local/bin/pass-cli

# --- deploy hook --------------------------------------------------------------
# Where certbot keeps certificates, for `arkkvm-deploy-hook --reapply`.
# Default: ~/.config/letsencrypt/live
#ARKKVM_LETSENCRYPT_LIVE=/home/you/.config/letsencrypt/live
# Location of the updater, if it isn't on PATH or in ~/.local/bin.
#ARKKVM_UPDATER_BIN=/home/you/.local/bin/arkkvm-cert-updater
